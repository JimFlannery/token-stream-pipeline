# Copy to .env and fill in. Nothing secret required for v1 —
# Coinbase Advanced Trade public channels and Pyth Hermes are unauthenticated.

# Kafka / Redpanda (matches docker-compose.yml defaults)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Upstream sources
# Coinbase Advanced Trade — US-legal replacement for Binance (stream.binance.com is
# geoblocked 451, and Binance.US silently disabled trade/aggTrade WS streams).
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
PYTH_HERMES_URL=https://hermes.pyth.network

# Pyth price feed IDs (mainnet)
# SOL/USD: https://pyth.network/price-feeds/crypto-sol-usd
PYTH_FEED_SOL_USD=ef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d
# USDC/USD: https://pyth.network/price-feeds/crypto-usdc-usd
PYTH_FEED_USDC_USD=eaa020c61cc479712813461ce153894a96a6c00b21ed0cfc2798d1f9a9e9c94a
